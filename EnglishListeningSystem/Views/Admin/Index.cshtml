@using EnglishListeningSystem.Models.ViewModel
@model IEnumerable<EnglishListeningSystem.Models.TaiKhoan>

@{
    Layout = "~/Views/Shared/_Layout_Admin.cshtml";
    ViewData["Title"] = "Quản trị hệ thống";
    var thongKeBaiHoc = (IReadOnlyList<ThongKeBaiHoc>)ViewBag.ThongKeBaiHoc;
    IReadOnlyList<YeuCauGiangVien> dsChoDuyet = (IReadOnlyList<YeuCauGiangVien>)ViewBag.DsChoDuyet;
    int soLuongChoDuyet = (int)ViewBag.SoLuongChoDuyet;
    string? thongBaoLoi = TempData["ErrorMessage"] as string;
    var thongKeHocVien = new[]
    {
        (Nhan: "Tổng số học viên", GiaTri: (int)ViewBag.TongHocVien, Mau: "text-primary-emphasis"),
        (Nhan: "Đang hoạt động", GiaTri: (int)ViewBag.HocVienHoatDong, Mau: "text-success-emphasis"),
        (Nhan: "Đang bị khóa", GiaTri: (int)ViewBag.HocVienBiKhoa, Mau: "text-danger-emphasis")
    };
}

<h1 class="h2 fw-semibold mb-4">Quản trị hệ thống</h1>

@if (TempData["SuccessMessage"] is string thongBao)
{
    <div class="alert alert-success" role="status">@thongBao</div>
}
@if (thongBaoLoi != null)
{
    <div class="alert alert-danger" role="alert">@thongBaoLoi</div>
}

<section class="card shadow-sm mb-4" aria-labelledby="tieuDeThongBaoPheDuyet">
    <h2 class="h6 mb-0" id="tieuDeThongBaoPheDuyet">
        <button class="btn btn-light d-flex align-items-center gap-2 w-100 p-3 text-start fw-semibold" type="button"
                data-bs-toggle="collapse" data-bs-target="#thongBaoPheDuyet"
                aria-expanded="false" aria-controls="thongBaoPheDuyet">
            <i class="bi bi-bell-fill text-primary" aria-hidden="true"></i>
            <span>Thông báo phê duyệt</span>
            <span class="badge rounded-pill text-bg-danger" aria-label="@soLuongChoDuyet yêu cầu đang chờ">@soLuongChoDuyet</span>
            <i class="bi bi-chevron-down ms-auto" aria-hidden="true"></i>
        </button>
    </h2>
    <div class="collapse" id="thongBaoPheDuyet">
        @if (dsChoDuyet.Count == 0)
        {
            <p class="card-body text-body-secondary border-top mb-0">Không có thông báo yêu cầu phê duyệt mới.</p>
        }
        else
        {
            <div class="list-group list-group-flush border-top">
                @foreach (YeuCauGiangVien gv in dsChoDuyet)
                {
                    string ngayGui = gv.NgayGui.ToString("dd/MM/yyyy HH:mm");
                    <button class="list-group-item list-group-item-action d-flex align-items-center gap-3 px-3 py-3" type="button"
                            data-bs-toggle="modal" data-bs-target="#modalChiTietGiangVien" data-yeu-cau-id="@gv.Id"
                            data-ho-ten="@gv.HoTen" data-ten-dang-nhap="@gv.TenDangNhap" data-email="@gv.Email"
                            data-ngay-gui="@ngayGui">
                        <i class="bi bi-person-vcard fs-5 text-primary" aria-hidden="true"></i>
                        <span class="flex-grow-1 text-break">
                            <strong class="d-block">@gv.HoTen</strong>
                            <span class="d-block small text-body-secondary">@gv.TenDangNhap · @gv.Email</span>
                        </span>
                        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
                    </button>
                }
            </div>
        }
    </div>
</section>

<ul class="nav nav-tabs gap-1 mb-4" role="tablist" aria-label="Chức năng quản trị">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tabHocVien" type="button" role="tab" data-bs-toggle="tab"
                data-bs-target="#mucHocVien" aria-controls="mucHocVien" aria-selected="true">
            <i class="bi bi-people me-1" aria-hidden="true"></i> Thống kê &amp; Quản lý tài khoản học viên
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tabBaiHoc" type="button" role="tab" data-bs-toggle="tab"
                data-bs-target="#mucBaiHoc" aria-controls="mucBaiHoc" aria-selected="false">
            <i class="bi bi-bar-chart me-1" aria-hidden="true"></i> Thống kê số lượng học &amp; Bài học được nghe nhiều
        </button>
    </li>
</ul>

<div class="tab-content">
    <section class="tab-pane fade show active" id="mucHocVien" role="tabpanel" aria-labelledby="tabHocVien" tabindex="0">
        <div class="row g-3 mb-4">
            @foreach (var chiSo in thongKeHocVien)
            {
                <div class="col-sm-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h2 class="h6 text-body-secondary">@chiSo.Nhan</h2>
                            <p class="fs-2 fw-semibold mb-0 @chiSo.Mau">@chiSo.GiaTri.ToString("N0")</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3" id="tieuDeHocVien">Danh sách tài khoản học viên</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" aria-labelledby="tieuDeHocVien">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-nowrap">Mã TK</th>
                                <th scope="col">Họ tên</th>
                                <th scope="col">Tên đăng nhập</th>
                                <th scope="col">Email</th>
                                <th scope="col" class="text-end">Điểm tích lũy</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr><td colspan="7" class="text-center text-body-secondary py-4">Chưa có tài khoản học viên.</td></tr>
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MaTK</td>
                                    <th scope="row" class="fw-medium text-break">@item.HoTen</th>
                                    <td class="text-break">@item.TenDangNhap</td>
                                    <td class="text-break">@item.Email</td>
                                    <td class="text-end">@item.DiemTichLuy.ToString("N0")</td>
                                    <td>
                                        @if (item.TrangThaiTK)
                                        {
                                            <span class="badge text-bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">Đang bị khóa</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            @if (item.TrangThaiTK)
                                            {
                                                <button class="btn btn-warning btn-sm" type="button" title="Khóa tài khoản"
                                                        aria-label="Khóa tài khoản @item.TenDangNhap" data-bs-toggle="modal"
                                                        data-bs-target="#modalKhoaTaiKhoan" data-ma-tk="@item.MaTK"
                                                        data-ho-ten="@item.HoTen" data-ten-dang-nhap="@item.TenDangNhap" data-email="@item.Email">
                                                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                                                </button>
                                                <button class="btn btn-secondary btn-sm opacity-25" type="button" aria-label="Mở khóa tài khoản" disabled>
                                                    <i class="bi bi-unlock-fill" aria-hidden="true"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary btn-sm opacity-25" type="button" aria-label="Khóa tài khoản" disabled>
                                                    <i class="bi bi-lock-fill" aria-hidden="true"></i>
                                                </button>
                                                <form asp-controller="Admin" asp-action="MoKhoaTaiKhoan" method="post">
                                                    <input type="hidden" name="id" value="@item.MaTK" />
                                                    <button class="btn btn-success btn-sm" type="submit" title="Mở khóa tài khoản"
                                                            aria-label="Mở khóa tài khoản @item.TenDangNhap">
                                                        <i class="bi bi-unlock-fill" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="tab-pane fade" id="mucBaiHoc" role="tabpanel" aria-labelledby="tabBaiHoc" tabindex="0">
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h6 text-body-secondary">Tổng số bài học</h2>
                        <p class="fs-2 fw-semibold mb-0 text-primary-emphasis">@(((int)ViewBag.TongBaiHoc).ToString("N0"))</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h6 text-body-secondary">Tổng lượt tham gia học</h2>
                        <p class="fs-2 fw-semibold mb-0 text-primary-emphasis">@(((long)ViewBag.TongLuotThamGia).ToString("N0"))</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3" id="tieuDeBaiHoc">Xếp hạng bài học theo lượt tham gia</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" aria-labelledby="tieuDeBaiHoc">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Hạng</th>
                                <th scope="col">Tên bài học</th>
                                <th scope="col">Danh mục</th>
                                <th scope="col">Cấp độ</th>
                                <th scope="col" class="text-end">Số học viên đã học</th>
                                <th scope="col" class="text-end">Tổng lượt luyện nghe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (thongKeBaiHoc.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-body-secondary py-4">Chưa có bài học.</td></tr>
                            }
                            @for (var i = 0; i < thongKeBaiHoc.Count; i++)
                            {
                                var baiHoc = thongKeBaiHoc[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <th scope="row" class="fw-medium text-break">@baiHoc.TenBaiHoc</th>
                                    <td>@baiHoc.DanhMuc</td>
                                    <td>@baiHoc.CapDo</td>
                                    <td class="text-end">@baiHoc.SoHocVien.ToString("N0")</td>
                                    <td class="text-end">@baiHoc.TongLuotLuyenNghe.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="modalKhoaTaiKhoan" tabindex="-1" aria-labelledby="tieuDeModalKhoa" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-controller="Admin" asp-action="KhoaTaiKhoan" method="post">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tieuDeModalKhoa">Xác nhận khóa tài khoản</h2>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" />
                <p>Bạn có muốn khóa tài khoản học viên này?</p>
                <dl class="row mb-0">
                    <dt class="col-5">Mã TK</dt>
                    <dd class="col-7" data-thong-tin="maTk"></dd>
                    <dt class="col-5">Họ tên</dt>
                    <dd class="col-7 text-break" data-thong-tin="hoTen"></dd>
                    <dt class="col-5">Tên đăng nhập</dt>
                    <dd class="col-7 text-break" data-thong-tin="tenDangNhap"></dd>
                    <dt class="col-5">Email</dt>
                    <dd class="col-7 text-break" data-thong-tin="email"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" type="submit">OK</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalChiTietGiangVien" tabindex="-1" aria-labelledby="tieuDeModalDuyet" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white text-dark">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tieuDeModalDuyet">Yêu cầu đăng ký giảng viên</h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-5">Họ tên</dt>
                    <dd class="col-7 text-break" data-thong-tin="hoTen"></dd>
                    <dt class="col-5">Tên đăng nhập</dt>
                    <dd class="col-7 text-break" data-thong-tin="tenDangNhap"></dd>
                    <dt class="col-5">Email</dt>
                    <dd class="col-7 text-break" data-thong-tin="email"></dd>
                    <dt class="col-5 mb-0">Ngày gửi</dt>
                    <dd class="col-7 mb-0" data-thong-tin="ngayGui"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-danger" id="nutKhongDuyetGiangVien" type="button"
                        data-bs-toggle="modal" data-bs-target="#modalXacNhanHuyYeuCau">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Không duyệt
                </button>
                <form asp-action="DuyetGiangVien" asp-controller="Admin" method="post">
                    <input type="hidden" name="id" />
                    <button class="btn btn-success" type="submit">
                        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Duyệt
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalXacNhanHuyYeuCau" tabindex="-1" aria-labelledby="tieuDeModalHuyYeuCau"
     aria-describedby="noiDungModalHuyYeuCau" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content bg-white text-dark" asp-action="HuyYeuCauGiangVien" asp-controller="Admin" method="post">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tieuDeModalHuyYeuCau">Xác nhận hủy yêu cầu</h2>
            </div>
            <div class="modal-body">
                <input type="hidden" name="id" />
                <p class="mb-0" id="noiDungModalHuyYeuCau">
                    Bạn muốn hủy yêu cầu đăng ký của <strong class="text-break" data-thong-tin="hoTen"></strong>?
                </p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" type="submit">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
