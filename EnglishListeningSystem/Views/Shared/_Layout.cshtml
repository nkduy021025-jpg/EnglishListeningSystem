@{
    var listeningLanding = ViewData["ListeningLanding"] is true;
    bool studentProfile = ViewData["StudentProfile"] is true;
    var loginError = TempData["LoginError"];
    var registerError = TempData["RegisterError"];
    var registerSuccess = listeningLanding ? TempData["RegisterSuccess"] : null;
    string? instructorPending = null;
    if (listeningLanding)
    {
        instructorPending = TempData["InstructorPending"] as string;
    }

    string? modalToShow = null;
    if (registerError != null)
    {
        modalToShow = "registerModal";
    }
    else if (instructorPending != null)
    {
        modalToShow = "instructorPendingModal";
    }
    else if (loginError != null || registerSuccess != null)
    {
        modalToShow = "loginModal";
    }

    string? lastUsername = null;
    if (loginError != null || registerSuccess != null)
    {
        lastUsername = TempData["LastUsername"] as string;
    }

    bool chonGiangVien = TempData["RegVaiTro"] as string == "Instructor";
    bool chonSinhVien = !chonGiangVien;

    var danhTinh = User.Identity;
    bool daDangNhap = danhTinh != null && danhTinh.IsAuthenticated;
    string lopNavbar = listeningLanding ? "listening-nav" : "bg-white border-bottom box-shadow mb-3";
}
<!DOCTYPE html>
<html lang="@(listeningLanding || studentProfile ? "en" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishListeningSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishListeningSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(listeningLanding ? "listening-landing" : null) @(studentProfile ? "student-profile-page" : null)">
    <header>
        <nav class="navbar @lopNavbar" aria-label="Main navigation">
            <div class="container gap-2">
                <a class="navbar-brand mb-0 me-0 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">EnglishListeningSystem</a>
                <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                    @if (daDangNhap)
                    {
                        <partial name="_RoleNavigation" />
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#logoutModal">Logout</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">@(listeningLanding ? "Login" : "Login")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="Login" asp-controller="Account">
                    <div class="modal-body">
                    
                        @if (loginError != null)
                        {
                            <div class="alert alert-danger py-2" role="alert">@loginError</div>
                        }
                        @if (registerSuccess != null)
                        {
                            <div class="alert alert-success py-2" role="status">@registerSuccess</div>
                        }
                        <div class="mb-3">
                            <label for="EmailOrUsername" class="col-form-label">@(listeningLanding ? "Username or Email" : "Username or Email")</label>
                            <input type="text" class="form-control" id="EmailOrUsername" name="EmailOrUsername" value="@lastUsername" />
                        </div>
                        <div class="mb-3">
                            <label for="Password" class="col-form-label">@(listeningLanding ? "Password" : "Password")</label>
                            <input type="password" class="form-control" id="Password" name="Password" />
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="RememberMe" id="RememberMeCheck" value="true" />
                            <label class="form-check-label" for="RememberMeCheck">Remember me</label>
                        </div>
                    
                    </div>
                    <div class="modal-footer">
                        <div class="mt-3">
                            @(listeningLanding ? "Don't have an account?" : "Don't have an account?")
                            <a href="#registerModal" data-bs-toggle="modal" data-bs-target="#registerModal">@(listeningLanding ? "Register" : "Register")</a>
                        </div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@(listeningLanding ? "Close" : "Close")</button>
                        <button type="submit" class="btn btn-primary">@(listeningLanding ? "Login" : "Login")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <form id="registerForm" class="modal-content bg-white text-dark" method="post" asp-action="Register" asp-controller="Account">
                <div class="modal-header">
                    <h5 class="modal-title" id="registerModalLabel">Register</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (registerError != null)
                    {
                        <div id="registerError" class="alert alert-danger py-2" role="alert">
                            @registerError
                        </div>
                    }
                    <div class="mb-3">
                        <label for="VaiTro" class="form-label fw-semibold">Role</label>
                        <select class="form-select" id="VaiTro" name="VaiTro" aria-describedby="vaiTroDangKyHelp" required>
                            <option value="Student" selected="@chonSinhVien">Student</option>
                            <option value="Instructor" selected="@chonGiangVien">Instructor</option>
                        </select>
                        <div class="form-text" id="vaiTroDangKyHelp">An administrator must approve instructor accounts.</div>
                    </div>
                    <div class="mb-3">
                        <label for="HoTen" class="col-form-label">Full Name</label>
                        <input type="text" class="form-control" id="HoTen" name="HoTen" value="@TempData["RegHoTen"]" required />
                    </div>
                    <div class="mb-3">
                        <label for="Username" class="col-form-label">Username</label>
                        <input type="text" class="form-control" id="Username" name="Username" value="@TempData["RegUsername"]" required />
                    </div>
                    <div class="mb-3">
                        <label for="Email" class="col-form-label">Email</label>
                        <input type="email" class="form-control" id="Email" name="Email" value="@TempData["RegEmail"]"
                               autocomplete="email" maxlength="150" required />
                    </div>
                    <div class="mb-3">
                        <label for="RegPassword" class="col-form-label">Password</label>
                        <input type="password" class="form-control" id="RegPassword" name="Password" required />
                    </div>
                    <div class="mb-3">
                        <label for="ConfirmPassword" class="col-form-label">Confirm Password</label>
                        <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" onclick="huyDangKy()">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-person-plus-fill me-1" aria-hidden="true"></i>Register
                    </button>
                </div>
            </form>
        </div>
    </div>
    @if (instructorPending != null)
    {
        <div class="modal fade" id="instructorPendingModal" tabindex="-1" aria-labelledby="instructorPendingModalLabel"
             aria-describedby="instructorPendingMessage" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-white text-dark shadow border-0">
                    <div class="modal-body text-center p-4 pt-5">
                        <i class="bi bi-hourglass-split text-warning fs-1" aria-hidden="true"></i>
                        <h2 class="h5 mt-3 mb-2" id="instructorPendingModalLabel">Request Pending Approval</h2>
                        <p class="mb-0" id="instructorPendingMessage">@instructorPending</p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">OK</a>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @(listeningLanding ? "EnglishListening" : "EnglishListeningSystem") - <a asp-area="" asp-controller="Home" asp-action="Privacy">@(listeningLanding ? "Privacy" : "Privacy")</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function huyDangKy() {
            var formDangKy = document.getElementById("registerForm");
            formDangKy.reset();

            // Reset đưa về dữ liệu ban đầu, nên xóa cả các giá trị được điền lại sau lỗi.
            var cacOInput = formDangKy.querySelectorAll('input:not([type="hidden"])');
            for (var i = 0; i < cacOInput.length; i++) {
                cacOInput[i].value = "";
            }
            formDangKy.elements["VaiTro"].value = "Student";

            var thongBaoLoi = document.getElementById("registerError");
            if (thongBaoLoi) {
                thongBaoLoi.hidden = true;
            }
        }
    </script>
    @if (modalToShow != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modalElement = document.getElementById('@modalToShow');
                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_LogoutModal" />
</body>
</html>
