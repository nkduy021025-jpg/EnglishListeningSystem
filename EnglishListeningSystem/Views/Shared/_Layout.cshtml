@{
    var listeningLanding = ViewData["ListeningLanding"] is true;
    var loginError = TempData["LoginError"];
    var registerError = TempData["RegisterError"];
    var registerSuccess = listeningLanding ? TempData["RegisterSuccess"] : null;
    var modalToShow = registerError != null ? "registerModal" :
        loginError != null || registerSuccess != null ? "loginModal" : null;
}
<!DOCTYPE html>
<html lang="@(listeningLanding ? "vi" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishListeningSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishListeningSystem.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(listeningLanding ? "listening-landing" : null)">
    <header>
        @if (listeningLanding)
        {
            <nav class="navbar listening-nav" aria-label="Điều hướng chính">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">EnglishListening</a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#loginModal">Đăng nhập</button>
                    }
                </div>
            </nav>
        }
        else
        {
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EnglishListeningSystem</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-whatever="">Login</a>  
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Link</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">Disabled</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
        }
    </header>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">@(listeningLanding ? "Đăng nhập" : "Login")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="login" asp-controller="Account">
                    <div class="modal-body">
                    
                        @if (loginError != null)
                                {
                                    <div class="alert alert-danger py-2" role="alert">
                                        @loginError
                                    </div>
                                }
                        @if (registerSuccess != null)
                        {
                            <div class="alert alert-success py-2" role="status">@registerSuccess</div>
                        }
                        <div class="mb-3">
                            <label for="EmailOrUsername" class="col-form-label">@(listeningLanding ? "Tên đăng nhập hoặc email" : "Username or Email:")</label>
                            <input type="text" class="form-control" id="EmailOrUsername" name="EmailOrUsername" value="@(registerSuccess != null ? TempData["LastUsername"] : null)" />
                        </div>
                        <div class="mb-3">
                            <label for="Password" class="col-form-label">@(listeningLanding ? "Mật khẩu" : "Password:")</label>
                            <input type="password" class="form-control" id="Password" name="Password" />
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="RememberMe" id="RememberMeCheck" value="true" />
                            <label class="form-check-label" for="RememberMeCheck">Ghi nhớ đăng nhập</label>
                        </div>
                    
                    </div>
                    <div class="modal-footer">
                        <div class="mt-3">
                            @(listeningLanding ? "Chưa có tài khoản?" : "Don't have an account?")
                            <a href="#registerModal" data-bs-toggle="modal" data-bs-target="#registerModal">@(listeningLanding ? "Đăng ký" : "Register")</a>
                        </div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@(listeningLanding ? "Đóng" : "Close")</button>
                        <button type="submit" class="btn btn-primary">@(listeningLanding ? "Đăng nhập" : "Login")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="registerModalLabel">Đăng ký tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="Register" asp-controller="Account">
                    <div class="modal-body">
                        @if (registerError != null)
                        {
                            <div class="alert alert-danger py-2" role="alert">
                                @registerError
                            </div>
                        }
                        <div class="mb-3">
                            <label for="HoTen" class="col-form-label">Họ và tên:</label>
                            <input type="text" class="form-control" id="HoTen" name="HoTen" value="@TempData["RegHoTen"]" required />
                        </div>
                        <div class="mb-3">
                            <label for="Username" class="col-form-label">Tên đăng nhập:</label>
                            <input type="text" class="form-control" id="Username" name="Username" value="@TempData["RegUsername"]" required />
                        </div>
                        <div class="mb-3">
                            <label for="Email" class="col-form-label">Email:</label>
                            <input type="email" class="form-control" id="Email" name="Email" value="@TempData["RegEmail"]" required />
                        </div>
                        <div class="mb-3">
                            <label for="RegPassword" class="col-form-label">Mật khẩu:</label>
                            <input type="password" class="form-control" id="RegPassword" name="Password" required />
                        </div>
                        <div class="mb-3">
                            <label for="ConfirmPassword" class="col-form-label">Xác nhận mật khẩu:</label>
                            <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success">Đăng ký</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @(listeningLanding ? "EnglishListening" : "EnglishListeningSystem") - <a asp-area="" asp-controller="Home" asp-action="Privacy">@(listeningLanding ? "Quyền riêng tư" : "Privacy")</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (modalToShow != null)
    {
        <script>
                document.addEventListener("DOMContentLoaded", function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('@modalToShow')).show();
                });
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
