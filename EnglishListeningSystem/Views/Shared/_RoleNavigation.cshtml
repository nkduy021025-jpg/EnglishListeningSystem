@{
    var danhTinh = User.Identity;
    bool daDangNhap = danhTinh != null && danhTinh.IsAuthenticated;
    string? controllerHienTai = ViewContext.RouteData.Values["controller"]?.ToString();
}

@if (daDangNhap && User.IsInRole("Student"))
{
    bool dangOStudent = string.Equals(controllerHienTai, "Student", StringComparison.OrdinalIgnoreCase);
    string? lopActive = dangOStudent ? "active" : null;
    string? viTriHienTai = dangOStudent ? "location" : null;

    <a class="role-nav-link @lopActive" aria-current="@viTriHienTai" asp-controller="Student" asp-action="Index">
        <i class="bi bi-headphones me-1" aria-hidden="true"></i>Learning Hub
    </a>
}
else if (daDangNhap && User.IsInRole("Admin"))
{
    bool dangOAdmin = string.Equals(controllerHienTai, "Admin", StringComparison.OrdinalIgnoreCase);
    string? lopActive = dangOAdmin ? "active" : null;
    string? viTriHienTai = dangOAdmin ? "location" : null;
    string tenMucQuanTri = dangOAdmin ? "Dashboard" : "Admin Dashboard";

    <a class="role-nav-link @lopActive" aria-current="@viTriHienTai" asp-controller="Admin" asp-action="Index">
        <i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>@tenMucQuanTri
    </a>
}
else if (daDangNhap && User.IsInRole("Instructor"))
{
    bool dangOInstructor = string.Equals(controllerHienTai, "Instructor", StringComparison.OrdinalIgnoreCase);
    string? lopActive = dangOInstructor ? "active" : null;
    string? viTriHienTai = dangOInstructor ? "location" : null;
    string tenMucGiangVien = dangOInstructor ? "Lesson Management" : "Instructor Portal";

    <a class="role-nav-link @lopActive" aria-current="@viTriHienTai" asp-controller="Instructor" asp-action="Index">
        <i class="bi bi-easel me-1" aria-hidden="true"></i>@tenMucGiangVien
    </a>
}

@if (daDangNhap)
{
    string? actionHienTai = ViewContext.RouteData.Values["action"]?.ToString();
    bool dangOHoSo = string.Equals(controllerHienTai, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(actionHienTai, "ThongTinCaNhan", StringComparison.OrdinalIgnoreCase);
    string? lopActive = dangOHoSo ? "active" : null;
    string? viTriHienTai = dangOHoSo ? "page" : null;
    string tenHienThi = danhTinh?.Name ?? "Profile";

    <a class="role-nav-link @lopActive" aria-current="@viTriHienTai" title="Profile"
       asp-controller="Account" asp-action="ThongTinCaNhan">
        <i class="bi bi-person-circle me-1 flex-shrink-0" aria-hidden="true"></i><span class="text-break">@tenHienThi</span>
    </a>
}
