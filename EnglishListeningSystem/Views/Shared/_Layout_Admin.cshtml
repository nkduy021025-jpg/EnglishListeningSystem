<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishListeningSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-body-tertiary">
    <header class="bg-white border-bottom">
        <nav class="container-xl navbar py-3 gap-2" aria-label="Điều hướng quản trị">
            <a class="navbar-brand text-primary-emphasis fw-semibold me-0" asp-controller="Admin" asp-action="Index">
                EnglishListeningSystem - Admin
            </a>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="fw-medium">
                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i>@User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-primary btn-sm" type="submit">Đăng xuất</button>
                </form>
            </div>
        </nav>
    </header>

    <main class="container-xl py-4 py-lg-5">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
