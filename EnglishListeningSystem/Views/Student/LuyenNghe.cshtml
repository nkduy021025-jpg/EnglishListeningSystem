@using System.Text.Json
@model StudentPracticeViewModel

@{
    ViewData["Title"] = Model.Title;
    var hasVideo = Uri.TryCreate(Model.VideoUrl, UriKind.Absolute, out var video)
        && (video.Scheme == Uri.UriSchemeHttps || video.Scheme == Uri.UriSchemeHttp);
    var diemTrungBinh = (double)ViewBag.DiemDanhGiaTrungBinh;
    var tongLuotDanhGia = (int)ViewBag.TongLuotDanhGia;
    var danhGiaHienTai = (DanhGia?)ViewBag.DanhGiaHienTai;
    var danhGiaMoiNhat = (IReadOnlyList<DanhGia>)ViewBag.DanhGiaMoiNhat;
    var soSaoDaChon = danhGiaHienTai?.SoSao ?? 0;
}

<nav aria-label="Đường dẫn">
    <ol class="breadcrumb student-breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Chủ đề luyện nghe</a></li>
        <li class="breadcrumb-item"><a asp-action="Baihoc" asp-route-id="@Model.CategoryId">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<header class="practice-heading">
    <h1 class="student-title">@Model.Title</h1>
    <span class="topic-count">Cấp độ @Model.Level</span>
    @if (tongLuotDanhGia > 0)
    {
        <span class="badge lesson-rating-badge">
            <i class="bi bi-star-fill text-warning" aria-hidden="true"></i>
            @diemTrungBinh.ToString("F1") / 5 · @tongLuotDanhGia lượt đánh giá
        </span>
    }
    else
    {
        <span class="topic-count">Chưa có đánh giá</span>
    }
</header>

<ul class="nav nav-tabs practice-tabs" role="tablist" aria-label="Nội dung bài học">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="dictation-tab" data-bs-toggle="tab" data-bs-target="#dictation"
                type="button" role="tab" aria-controls="dictation" aria-selected="true">Chép chính tả</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="transcript-tab" data-bs-toggle="tab" data-bs-target="#transcript"
                type="button" role="tab" aria-controls="transcript" aria-selected="false">Bản chép đầy đủ</button>
    </li>
</ul>

<div class="tab-content practice-panel">
    <section class="tab-pane show active" id="dictation" role="tabpanel" aria-labelledby="dictation-tab"
             tabindex="0" data-sentences="@JsonSerializer.Serialize(Model.Sentences)" data-sentence-position="@Model.SentencePosition">
        @if (Model.Sentences.Count > 0)
        {
            <div class="practice-navigation" aria-label="Điều hướng câu">
                <button type="button" class="btn btn-outline-secondary" id="previous-sentence" aria-label="Câu trước"
                        disabled="@(Model.SentencePosition == 1)">←</button>
                <span id="sentence-position" aria-live="polite">Câu @Model.SentencePosition / @Model.Sentences.Count</span>
                <button type="button" class="btn btn-outline-secondary" id="next-sentence" aria-label="Câu tiếp theo"
                        disabled="@(Model.SentencePosition == Model.Sentences.Count)">→</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AudioUrl))
        {
            <div class="practice-audio">
                <audio id="lesson-audio" controls preload="metadata" src="@Url.Content(Model.AudioUrl)" aria-label="Audio bài học"></audio>
                <label for="playback-rate">Tốc độ</label>
                <select class="form-select" id="playback-rate">
                    <option value="0.75">0.75×</option>
                    <option value="1" selected>1×</option>
                    <option value="1.25">1.25×</option>
                    <option value="1.5">1.5×</option>
                </select>
            </div>
        }
        else if (hasVideo)
        {
            <p><a href="@video" target="_blank" rel="noopener noreferrer">Mở video bài học ↗</a></p>
        }
        else
        {
            <p>Bài học này chưa có audio hoặc video.</p>
        }

        @if (Model.Sentences.Count > 0)
        {
            <form id="dictation-form" class="practice-form">
                <label class="form-label fw-semibold" for="dictation-answer">Câu bạn nghe được</label>
                <textarea class="form-control mb-3" id="dictation-answer" rows="4" required
                          placeholder="Nhập câu tiếng Anh..." spellcheck="false"></textarea>
                <button class="lesson-filter-button" type="submit">Kiểm tra</button>
                <button class="btn btn-outline-secondary ms-2" id="skip-sentence" type="button"
                        disabled="@(Model.SentencePosition == Model.Sentences.Count)">Bỏ qua</button>
                <p class="mt-3 mb-0" id="dictation-feedback" role="status"></p>
            </form>
        }
        else
        {
            <p class="mb-0">Bài học này chưa có câu chép chính tả đã duyệt.</p>
        }
    </section>

    <section class="tab-pane" id="transcript" role="tabpanel" aria-labelledby="transcript-tab" tabindex="0">
        @if (Model.Sentences.Count > 0)
        {
            <ol class="practice-transcript" lang="en">
                @foreach (var sentence in Model.Sentences)
                {
                    <li>@sentence.Text</li>
                }
            </ol>
        }
        else
        {
            <p class="mb-0">Bản chép chưa có nội dung.</p>
        }
    </section>
</div>

<section class="card lesson-rating-card mt-4" aria-labelledby="lesson-rating-title">
    <div class="card-body p-3 p-sm-4">
        <h2 class="h5 mb-3" id="lesson-rating-title">Đánh giá mức độ hài lòng bài học</h2>

        @if (TempData["DanhGiaSuccess"] is string success)
        {
            <p class="alert alert-success" role="status">@success</p>
        }
        @if (TempData["DanhGiaError"] is string error)
        {
            <p class="alert alert-danger" role="alert">@error</p>
        }

        <form asp-action="DanhGiaBaiHoc" method="post" id="lesson-rating-form">
            <input type="hidden" name="maBH" value="@Model.LessonId" />
            <input type="hidden" name="thuTu" id="rating-sentence-position" value="@Model.SentencePosition" />
            <input type="hidden" name="soSao" value="@soSaoDaChon" />

            <fieldset class="mb-3">
                <legend class="form-label fs-6 mb-1">Mức độ hài lòng (1 đến 5 sao)</legend>
                <div class="d-inline-flex" id="rating-stars">
                    @for (var sao = 1; sao <= 5; sao++)
                    {
                        <button class="rating-star" type="button" data-rating="@sao" aria-label="@sao sao"
                                aria-pressed="@((sao == soSaoDaChon) ? "true" : "false")">
                            <i class="bi @(sao <= soSaoDaChon ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                        </button>
                    }
                </div>
                <p class="text-warning small mb-0" id="rating-selection-error" role="alert" hidden>Vui lòng chọn số sao.</p>
            </fieldset>

            <label class="form-label" for="rating-comment">Nhận xét (tùy chọn)</label>
            <textarea class="form-control mb-3" id="rating-comment" name="nhanXet" rows="3"
                      maxlength="500" data-bs-theme="dark">@danhGiaHienTai?.NhanXet</textarea>
            <button class="btn btn-warning" type="submit">@(danhGiaHienTai == null ? "Gửi đánh giá" : "Cập nhật đánh giá")</button>
        </form>

        @if (danhGiaMoiNhat.Count > 0)
        {
            <h3 class="h6 mt-4 mb-0">Đánh giá mới nhất</h3>
            <ul class="list-unstyled mb-0">
                @foreach (var danhGia in danhGiaMoiNhat)
                {
                    <li class="lesson-rating-review pt-3 mt-3">
                        <div class="d-flex flex-wrap align-items-baseline gap-2">
                            <strong>@danhGia.MaTKNavigation.HoTen</strong>
                            <span class="text-warning small">
                                <i class="bi bi-star-fill" aria-hidden="true"></i> @danhGia.SoSao / 5 sao
                            </span>
                            <time class="small text-white-50" datetime="@danhGia.NgayDanhGia.ToString("s")">
                                @danhGia.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")
                            </time>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(danhGia.NhanXet))
                        {
                            <p class="lesson-rating-comment mb-0 mt-1">@danhGia.NhanXet</p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/student-practice.js" asp-append-version="true"></script>
    <script src="~/js/student-rating.js" asp-append-version="true"></script>
}
