@model StudentLessonsViewModel

@{
    ViewData["Title"] = Model.CategoryName;
    var sections = Model.Lessons.Chunk(20).ToArray();
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb student-breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Listening Topics</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.CategoryName</li>
    </ol>
</nav>

<div class="lesson-toolbar">
    <h1 class="student-title">@Model.CategoryName</h1>
    <form class="lesson-filters" asp-action="Baihoc" method="get" role="search">
        <input type="hidden" name="id" value="@Model.CategoryId" />
        <input class="form-control" type="search" name="search" value="@Model.Search"
               placeholder="Lesson Title" aria-label="Search by lesson title" />
        <select class="form-select" name="level" aria-label="Level">
            <option value="">All Levels</option>
            @foreach (var level in Model.Levels)
            {
                <option value="@level" selected="@string.Equals(level, Model.Level, StringComparison.OrdinalIgnoreCase)">@level</option>
            }
        </select>
        <button class="lesson-filter-button" type="submit">Filter</button>
    </form>
</div>

@if (sections.Length == 0)
{
    <p class="student-empty">
        @(Model.Search.Length > 0 || Model.Level.Length > 0
            ? "No lessons match your filters."
            : "There are no lessons in this topic yet.")
    </p>
}
else
{
    @for (var index = 0; index < sections.Length; index++)
    {
        <details class="lesson-section" open="@(index == 0 ? "open" : null)">
            <summary>
                <strong>Section @(index + 1)</strong>
                <span>Lessons: @sections[index].Length</span>
            </summary>
            <ol class="lesson-grid" start="@(index * 20 + 1)">
                @foreach (var lesson in sections[index])
                {
                    <li>
                        <a class="lesson-link stretched-link" asp-action="Lesson" asp-route-id="@lesson.Id">@lesson.Title</a>
                        <div class="lesson-meta">Sentences: @lesson.SentenceCount · Level @lesson.Level</div>
                        @if (lesson.RatingCount > 0)
                        {
                            <span class="badge lesson-rating-badge mt-2" aria-label="@lesson.AverageRating.ToString("F1") out of 5 stars. Reviews: @lesson.RatingCount">
                                <i class="bi bi-star-fill text-warning" aria-hidden="true"></i>
                                @lesson.AverageRating.ToString("F1") (@lesson.RatingCount)
                            </span>
                        }
                    </li>
                }
            </ol>
        </details>
    }
}
