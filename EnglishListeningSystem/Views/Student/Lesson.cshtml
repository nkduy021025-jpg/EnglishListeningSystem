@using System.Text.Json
@using System.Globalization
@model BaiHoc

@{
    ViewData["Title"] = Model.TenBH;
    var hasVideo = Uri.TryCreate(Model.YoutubeUrl, UriKind.Absolute, out var video)
        && (video.Scheme == Uri.UriSchemeHttps || video.Scheme == Uri.UriSchemeHttp);
    bool coAudio = (bool)ViewBag.CoAudio;
    IReadOnlyList<CauChep> dsCau = (IReadOnlyList<CauChep>)ViewBag.DanhSachCau;
    IReadOnlyList<int> cacCauDaXong = (IReadOnlyList<int>)ViewBag.CacCauDaXong;
    int viTriCau = (int)ViewBag.ViTriCau;
    decimal diemTienDo = (decimal)ViewBag.DiemTienDo;
    var mocCacCau = dsCau.Select(cau => new { Id = cau.MaCau, Start = cau.ThoiGianBatDau, End = cau.ThoiGianKetThuc });
    var diemTrungBinh = (double)ViewBag.DiemDanhGiaTrungBinh;
    var tongLuotDanhGia = (int)ViewBag.TongLuotDanhGia;
    var danhGiaHienTai = (DanhGia?)ViewBag.DanhGiaHienTai;
    var danhGiaMoiNhat = (IReadOnlyList<DanhGia>)ViewBag.DanhGiaMoiNhat;
    var soSaoDaChon = danhGiaHienTai?.SoSao ?? 0;
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb student-breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Listening Topics</a></li>
        <li class="breadcrumb-item"><a asp-action="Baihoc" asp-route-id="@Model.MaDM">@Model.MaDMNavigation.TenDM</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TenBH</li>
    </ol>
</nav>

<header class="practice-heading">
    <h1 class="student-title">@Model.TenBH</h1>
    <span class="topic-count">Level @Model.CapDo</span>
    @if (tongLuotDanhGia > 0)
    {
        <span class="badge lesson-rating-badge">
            <i class="bi bi-star-fill text-warning" aria-hidden="true"></i>
            @diemTrungBinh.ToString("F1") / 5 · Reviews: @tongLuotDanhGia
        </span>
    }
    else
    {
        <span class="topic-count">No reviews yet</span>
    }
</header>

<ul class="nav nav-tabs practice-tabs" role="tablist" aria-label="Lesson content">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="dictation-tab" data-bs-toggle="tab" data-bs-target="#dictation"
                type="button" role="tab" aria-controls="dictation" aria-selected="true">Dictation</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="transcript-tab" data-bs-toggle="tab" data-bs-target="#transcript"
                type="button" role="tab" aria-controls="transcript" aria-selected="false">Full Transcript</button>
    </li>
</ul>

<div class="tab-content practice-panel">
    <section class="tab-pane show active" id="dictation" role="tabpanel" aria-labelledby="dictation-tab"
             tabindex="0" data-sentences="@JsonSerializer.Serialize(mocCacCau)" data-sentence-position="@viTriCau"
             data-completed="@JsonSerializer.Serialize(cacCauDaXong)">
        @if (ViewBag.LoiPhuDe is string loiPhuDe)
        {
            <p class="alert alert-warning" role="alert">@loiPhuDe</p>
        }
        @if (dsCau.Count > 0)
        {
            <div class="practice-navigation rounded-3 p-2" role="group" aria-label="Sentence navigation">
                <button type="button" class="btn btn-outline-secondary" id="previous-sentence" aria-label="Previous sentence"
                        disabled="@(viTriCau == 1)"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Previous</button>
                <span id="sentence-position" class="fw-semibold" aria-live="polite">Sentence @viTriCau / @dsCau.Count</span>
                <button type="button" class="btn btn-outline-secondary" id="next-sentence" aria-label="Next sentence"
                        disabled="@(viTriCau == dsCau.Count)">Next<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
                <span class="badge practice-completed" id="sentence-completed"
                      hidden="@(!cacCauDaXong.Contains(dsCau[viTriCau - 1].MaCau))">Completed</span>
            </div>
            <p class="small mb-3" id="lesson-progress" role="status">
                @cacCauDaXong.Count / @dsCau.Count sentences completed (@diemTienDo.ToString("0.##", CultureInfo.InvariantCulture)%)
            </p>
        }

        @if (coAudio)
        {
            <audio id="audioPlayer" src="@Url.Action("PhatAudio", "Student", new { maBH = Model.MaBH })"
                   preload="auto" controls="@(dsCau.Count == 0)" aria-label="Lesson audio"></audio>
            @if (dsCau.Count > 0)
            {
                <div class="practice-audio" role="group" aria-label="Playback controls">
                    <button type="button" class="lesson-filter-button" id="play-sentence">
                        <i class="bi bi-play-fill me-1" aria-hidden="true"></i><span>Play</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="replay-sentence" aria-keyshortcuts="Control">
                        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Replay
                    </button>
                    <label for="playback-rate">Speed</label>
                    <select class="form-select" id="playback-rate">
                        <option value="0.75">0.75×</option>
                        <option value="1" selected>1.0×</option>
                        <option value="1.25">1.25×</option>
                    </select>
                </div>
                <p class="small text-danger mb-3" role="status" id="audio-message" hidden></p>
            }
        }
        else if (hasVideo)
        {
            <p><a href="@video" target="_blank" rel="noopener noreferrer">Open Lesson Video ↗</a></p>
        }
        else
        {
            <p>This lesson has no audio or video yet.</p>
        }

        @if (dsCau.Count > 0)
        {
            <form id="dictation-form" class="practice-form" asp-action="KiemTraTranscript" method="post">
                <input type="hidden" name="maCau" value="@dsCau[viTriCau - 1].MaCau" />
                <label class="form-label fw-semibold" for="transcriptInput">Type What You Hear</label>
                <textarea class="form-control mb-3" id="transcriptInput" name="noiDungNhap" rows="4" required
                          maxlength="@KhoAmThanhBaiHoc.GioiHanTranscript" placeholder="Type what you hear..." spellcheck="false"></textarea>
                <div class="d-flex flex-wrap gap-2">
                    <button class="lesson-filter-button" type="submit" id="check-transcript">Check</button>
                    <button class="btn btn-outline-secondary" id="show-transcript" type="button"
                            aria-controls="current-transcript" aria-expanded="false">Show Transcript</button>
                </div>
                <p id="current-transcript" class="practice-answer rounded-3 p-3 mt-3 mb-0" hidden></p>
            </form>
            <section class="card lesson-rating-card mt-3" id="transcript-result" aria-label="Transcript result"
                     aria-live="polite" hidden>
                <div class="card-body">
                    <p class="fw-semibold mb-0" id="dictation-feedback"></p>
                    <ul class="list-unstyled d-flex flex-wrap gap-2 mt-3 mb-0 transcript-words" id="transcript-words"
                        aria-label="Word comparison" hidden></ul>
                </div>
            </section>
        }
        else
        {
            <p class="mb-0">This lesson has no approved dictation sentences yet.</p>
        }
    </section>

    <section class="tab-pane" id="transcript" role="tabpanel" aria-labelledby="transcript-tab" tabindex="0">
        @if (dsCau.Count > 0)
        {
            <ol class="practice-transcript" lang="en">
                @foreach (CauChep sentence in dsCau)
                {
                    <li>@sentence.NoiDungChuan</li>
                }
            </ol>
        }
        else
        {
            <p class="mb-0">There is no transcript for this lesson yet.</p>
        }
    </section>
</div>

<section class="card lesson-rating-card mt-4" aria-labelledby="lesson-rating-title">
    <div class="card-body p-3 p-sm-4">
        <h2 class="h5 mb-3" id="lesson-rating-title">Rate This Lesson</h2>

        @if (TempData["DanhGiaSuccess"] is string success)
        {
            <p class="alert alert-success" role="status">@success</p>
        }
        @if (TempData["DanhGiaError"] is string error)
        {
            <p class="alert alert-danger" role="alert">@error</p>
        }

        <form asp-action="DanhGiaBaiHoc" method="post" id="lesson-rating-form">
            <input type="hidden" name="maBH" value="@Model.MaBH" />
            <input type="hidden" name="thuTu" id="rating-sentence-position" value="@viTriCau" />
            <input type="hidden" name="soSao" value="@soSaoDaChon" />

            <fieldset class="mb-3">
                <legend class="form-label fs-6 mb-1">Rating (1 to 5 stars)</legend>
                <div class="d-inline-flex" id="rating-stars">
                    @for (var sao = 1; sao <= 5; sao++)
                    {
                        <button class="rating-star" type="button" data-rating="@sao" aria-label="@sao out of 5 stars"
                                aria-pressed="@((sao == soSaoDaChon) ? "true" : "false")">
                            <i class="bi @(sao <= soSaoDaChon ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                        </button>
                    }
                </div>
                <p class="text-warning small mb-0" id="rating-selection-error" role="alert" hidden>Please select a rating.</p>
            </fieldset>

            <label class="form-label" for="rating-comment">Comment (optional)</label>
            <textarea class="form-control mb-3" id="rating-comment" name="nhanXet" rows="3"
                      maxlength="500" data-bs-theme="dark">@danhGiaHienTai?.NhanXet</textarea>
            <button class="btn btn-warning" type="submit">@(danhGiaHienTai == null ? "Submit Review" : "Update Review")</button>
        </form>

        @if (danhGiaMoiNhat.Count > 0)
        {
            <h3 class="h6 mt-4 mb-0">Latest Reviews</h3>
            <ul class="list-unstyled mb-0">
                @foreach (var danhGia in danhGiaMoiNhat)
                {
                    <li class="lesson-rating-review pt-3 mt-3">
                        <div class="d-flex flex-wrap align-items-baseline gap-2">
                            <strong>@danhGia.MaTKNavigation.HoTen</strong>
                            <span class="text-warning small">
                                <i class="bi bi-star-fill" aria-hidden="true"></i> @danhGia.SoSao / 5 stars
                            </span>
                            <time class="small text-white-50" datetime="@danhGia.NgayDanhGia.ToString("s")">
                                @danhGia.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")
                            </time>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(danhGia.NhanXet))
                        {
                            <p class="lesson-rating-comment mb-0 mt-1">@danhGia.NhanXet</p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/student-practice.js" asp-append-version="true"></script>
    <script src="~/js/student-rating.js" asp-append-version="true"></script>
}
